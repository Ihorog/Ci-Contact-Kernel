# Ci Contact Kernel — environment variables example
# Copy to .env and fill in values. Never commit .env to the repository.

# Port for local development (default: 3000)
PORT=3000

# Keenetic MCP upstream.
# Store the full tokenized https://mcp.keenetic.cloud URL only as a runtime secret.
KEENETIC_MCP_URL=

# Independent bearer secret protecting the public Ci gateway.
# Do not reuse the Keenetic MCP token here.
CI_KEENETIC_PROXY_KEY=

# Ci+ GPT/MCP connector. Read-only by default.
CI_CONTROL_PLANE_URL=https://ciplus.cimeika.com.ua
CI_MCP_WRITE_ENABLED=false
CI_MCP_TOKEN=
CI_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://platform.openai.com

# Vodyanyi — HOME.WATER.VODYANYI one-click water procedure.
# The trigger secret is provisioned to trusted Ci clients only. Never put it in an NFC URL.
VODYANYI_TRIGGER_SECRET=

# Internal executor endpoint. It must support two POST actions: quote, then submit.
VODYANYI_EXECUTOR_URL=
VODYANYI_EXECUTOR_TOKEN=
VODYANYI_EXECUTOR_TIMEOUT_MS=12000

# The JSON profile contains only vault references, never plaintext address or phone.
# Replace the example provider/cap and resolve recipientRef/deliveryRef in the private executor.
VODYANYI_STANDARD_PROFILE_JSON={"provider":"verified-water-provider","quantity":2,"bottleLiters":18.9,"waterType":"standard","maxTotalUAH":250,"exchangeEmptyBottles":true,"recipientRef":"vault://home/water/recipient","deliveryRef":"vault://home/water/address","procedureVersion":"1","verified":true}
VODYANYI_MAX_QUOTE_AGE_SECONDS=300
VODYANYI_ORDER_COOLDOWN_HOURS=24
