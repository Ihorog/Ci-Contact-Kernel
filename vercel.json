{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**"]
      }
    },
    {
      "src": "src/ciMcpServer.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/mcp/ci/?$",
      "dest": "src/ciMcpServer.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ]
}
