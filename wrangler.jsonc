{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ci-contact-kernel",
  "main": "src/workerWithCiMcp.mjs",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ci/*",
      "/ciopen/*",
      "/mcp/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VODYANYI_STATE",
        "class_name": "VodyanyiState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "vodyanyi-v1",
      "new_sqlite_classes": ["VodyanyiState"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
