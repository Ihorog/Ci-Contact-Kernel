{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ci-contact-kernel",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ci/*",
      "/ciopen/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
